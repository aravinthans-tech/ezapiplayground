{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiKeys": {
    "ValidKeys": [
      "your-api-key-here-change-this-in-production"
    ]
  },
  "ConnectionStrings": {
    "eZApiTenantContext": "Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "ExternalApis": {
    "GoogleMaps": {
      "ApiKey": "YOUR_GOOGLE_MAPS_API_KEY",
      "GeocodingUrl": "https://maps.googleapis.com/maps/api/geocode/json"
    },
    "OpenRouter": {
      "ApiKey": "YOUR_OPENROUTER_API_KEY",
      "BaseUrl": "https://openrouter.ai/api/v1"
    },
    "Unstract": {
      "ApiKey": "YOUR_UNSTRACT_API_KEY",
      "BaseUrl": "https://llmwhisperer-api.us-central.unstract.com/api/v2"
    },
    "AwsRekognition": {
      "AccessKey": "YOUR_AWS_ACCESS_KEY",
      "SecretKey": "YOUR_AWS_SECRET_KEY",
      "Region": "ap-south-1"
    }
  },
  "KycVerification": {
    "ConsistencyThreshold": 0.82,
    "FaceMatchThreshold": 4,
    "DefaultModel": "Mistral"
  }
}

